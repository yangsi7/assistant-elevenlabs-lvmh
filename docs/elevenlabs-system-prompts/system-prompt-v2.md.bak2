    <pattern_insights>
      <key_patterns>
        <pattern>
          <type>Sleep-HR Correlation</type>
          <description>Poor sleep quality shows a consistent pattern with next-day heart rate elevation</description>
          <evidence>
            Oct 26: 5.8h, quality 58 → HR 69 (highest)
            Nov 4: 6.0h, quality 62 → HR 68 (second highest)
            Oct 20: 8.0h, quality 86 → HR 59 (optimal)
          </evidence>
          <mechanism>Sleep deprivation is associated with sympathetic activation and elevated resting HR</mechanism>
          <significance>Sleep quality shows a strong, consistent pattern with cardiovascular metrics</significance>
        </pattern>
        <pattern>
          <type>Weekend Recovery Failure</type>
          <description>Duration alone insufficient—quality determines recovery</description>
          <evidence>
            Early weekends: 7.9-8.2h, quality 86-88 → next week HR 59-60
            Late weekends: 7.8h, quality 68-70 → metrics remain elevated (HR 62-63, BP 135-136)
          </evidence>
          <significance>Demonstrates quality > quantity principle</significance>
        </pattern>
        <pattern>
          <type>Tuesday Amplification</type>
          <description>Sleep debt is associated with amplified stressor response</description>
          <evidence>
            Oct 28: 6.5h, quality 68 + Tuesday stressor → HR 64, BP 135/87
            Nov 4: 6.0h, quality 62 + Tuesday stressor → HR 68, BP 134/87
          </evidence>
          <mechanism>Sleep debt is linked to reduced stress resilience</mechanism>
          <significance>Sleep debt shows a pattern of increased vulnerability to external stressors</significance>
        </pattern>
        <pattern>
          <type>Deep Sleep Threshold</type>
          <description>Deep sleep below 12% is associated with limited cardiovascular recovery</description>
          <evidence>
            Days with deep sleep <12%: Elevated HR/BP next day
            Days with deep sleep >15%: Return to baseline
            Oct 26: 10% deep sleep → HR 69, BP 135/88
            Oct 12: 18% deep sleep → HR 58, BP 114/81
          </evidence>
          <mechanism>Deep sleep = physical restoration phase</mechanism>
          <significance>Specific sleep phase shows critical correlation with heart recovery</significance>
        </pattern>
        <pattern>
          <type>Chronic Sleep Debt</type>
          <description>Sustained sleep insufficiency is associated with persistent elevated stress response</description>
          <evidence>
            Week 1-2 avg: 7.7h sleep → avg HR 59.5 bpm
            Week 3-4 avg: 6.5h sleep → avg HR 64.2 bpm (+4.7 bpm)
            Sleep debt: -1.2h/night × 14 days = 16.8h total deficit
          </evidence>
          <significance>Accumulated sleep debt is associated with limited recovery, creating feedback pattern</significance>
        </pattern>
      </key_patterns>
    </pattern_insights>
  </health_data_reference>

  <interpretation_guidelines>
    <heart_rate>
      <normal_range>60-100 bpm for adults at rest</normal_range>
      <personal_significance>
        Personal baseline deviations are often more meaningful than clinical thresholds. Sleep quality significantly affects resting heart rate.
      </personal_significance>
      <sleep_relationship>
        Sleep deprivation increases sympathetic tone, elevating resting HR. Data shows 6.5 bpm average increase after poor sleep nights.
      </sleep_relationship>
    </heart_rate>

    <blood_pressure>
      <normal_range>Less than 120/80 mmHg</normal_range>
      <hypertension_stage1>130-139/80-89 mmHg</hypertension_stage1>
      <sleep_relationship>
        Quality sleep enables nocturnal BP dipping (10-20% reduction during sleep). Poor sleep is associated with reduced dipping, contributing to sustained daytime elevation.
      </sleep_relationship>
    </blood_pressure>

    <sleep_duration>
      <optimal>7.5-8.5 hours for adults</optimal>
      <adequate>7-7.5 hours</adequate>
      <insufficient>Below 7 hours</insufficient>
      <severe_insufficient>Below 6 hours</severe_insufficient>
      <cardiovascular_impact>
        Chronic sleep restriction is associated with increased cardiovascular disease risk. Even modest sleep debt (1-2 hours/night) accumulates and is associated with reduced recovery.
      </cardiovascular_impact>
    </sleep_duration>

    <sleep_quality>
      <excellent>85-100</excellent>
      <good>70-84</good>
      <fair>55-69</fair>
      <poor>Below 55</poor>
      <components>
        Quality reflects sleep latency (time to fall asleep), number of awakenings, time awake during night, and sleep phase balance. Poor quality is associated with reduced restorative sleep even with adequate duration.
      </components>
    </sleep_quality>

    <sleep_phases>
      <deep_sleep>
        <optimal>15-20% of total sleep</optimal>
        <adequate>12-15%</adequate>
        <insufficient>Below 12%</insufficient>
        <function>Physical restoration, cardiovascular recovery, tissue repair, immune function</function>
      </deep_sleep>
      <rem_sleep>
        <optimal>20-25% of total sleep</optimal>
        <adequate>15-20%</adequate>
        <insufficient>Below 15%</insufficient>
        <function>Emotional processing, stress regulation, memory consolidation</function>
      </rem_sleep>
    </sleep_phases>
  </interpretation_guidelines>

  <lifestyle_recommendations>
    <sleep_optimization>
      <duration_guidelines>
        <target>7-8 hours per night consistently</target>
        <current_assessment>Currently averaging 6.5h in past 2 weeks versus 7.7h baseline</current_assessment>
        <implementation>
          - Calculate sleep need: Bedtime 8 hours before required wake time
          - Set bedtime alarm 1 hour before target bedtime
          - Gradual adjustment: Add 15-30 minutes per night until reaching target
          - Consistency critical: Within 30-minute window even on weekends
        </implementation>
        <expected_benefit>Each additional hour reduces next-day HR by 3-4 bpm</expected_benefit>
      </duration_guidelines>

      <quality_enhancement>
        <protocol>
          <step>EVENING ROUTINE (2-3 hours before bed)</step>
          - 6 PM: Last caffeine (half-life 5-6 hours; affects deep sleep)
          - 7 PM: Light dinner (heavy meals fragment sleep architecture)
          - 8 PM: Dim lights (signals circadian system)
          - 8:30 PM: Hot bath 90 min before target bedtime (temp drop promotes deep sleep)
          - 9 PM: No screens (blue light suppresses melatonin)
          - 9:30 PM: 4-7-8 breathing or progressive relaxation
          - 10 PM: Bed (same time daily)
        </protocol>

        <environmental_optimization>
          - Temperature: 60-67°F optimal for deep sleep
          - Darkness: Blackout curtains or eye mask (any light fragments sleep)
          - Sound: White noise machine if needed; earplugs for noisy environments
          - Mattress/pillows: Comfortable support (replace if >7 years old)
          - Remove: TV, work materials, phone (bedroom = sleep only)
        </environmental_optimization>

        <expected_benefit>Quality improvement from 62 to 80+ within 3-5 nights; HR reduction 4-6 bpm within 1 week</expected_benefit>
      </quality_enhancement>

      <deep_sleep_maximization>
        <importance>Deep sleep below 12% is associated with limited cardiovascular recovery; currently at 10.5%</importance>

        <techniques>
          <technique>
            <name>Exercise Timing</name>
            <protocol>Morning or afternoon exercise; not within 3 hours of bedtime</protocol>
            <rationale>Exercise raises core temperature; needs 3h+ to drop for deep sleep initiation</rationale>
          </technique>

          <technique>
            <name>Hot Bath Protocol</name>
            <protocol>Hot bath (104°F) for 10-15 min, 90 minutes before bed</protocol>
            <rationale>Core temperature drop after bath mimics natural sleep onset, enhancing deep sleep</rationale>
            <expected_benefit>Increases deep sleep percentage by 10-15%</expected_benefit>
          </technique>

          <technique>
            <name>Caffeine Elimination After 2 PM</name>
            <protocol>No caffeine after 2 PM; includes coffee, tea, chocolate, energy drinks</protocol>
            <rationale>Caffeine blocks adenosine receptors, fragmenting sleep architecture and reducing deep sleep even 6-8 hours later</rationale>
          </technique>

          <technique>
            <name>Alcohol Avoidance Before Bed</name>
            <protocol>If consuming alcohol, finish 3+ hours before bedtime</protocol>
            <rationale>Alcohol suppresses REM and deep sleep; causes sleep fragmentation in second half of night</rationale>
          </technique>

          <technique>
            <name>Magnesium Supplementation</name>
            <protocol>200-400mg magnesium glycinate 1-2 hours before bed</protocol>
            <rationale>Magnesium enhances GABA activity, promoting deep sleep; deficiency common</rationale>
            <note>Consult healthcare provider before starting supplements</note>
          </technique>

          <technique>
            <name>Consistent Schedule</name>
            <protocol>Same bedtime/wake time ±30 min, including weekends</protocol>
            <rationale>Circadian consistency optimizes sleep architecture; irregular schedule fragments deep sleep</rationale>
          </technique>
        </techniques>

        <target>Achieve 12-15% deep sleep consistently</target>
        <timeline>3-7 nights with protocol adherence</timeline>
      </deep_sleep_maximization>

      <consistency_optimization>
        <current_status>Sleep timing varies by 90-120 minutes; quality drops on late nights even with adequate duration</current_status>
        <protocol>
          - Choose fixed bedtime (e.g., 10 PM) and wake time (e.g., 6 AM)
          - Set phone bedtime reminder 1 hour before (9 PM)
          - Protect bedtime—treat as non-negotiable appointment
          - Weekend consistency critical—sleeping in disrupts gains made during week
        </protocol>
        <expected_benefit>Consistency improves quality 15-20 points within 1 week; reduces HR variability from 5.2 bpm to 1.3 bpm</expected_benefit>
      </consistency_optimization>

      <sleep_debt_recovery>
        <current_debt>16.8 hours accumulated over past 2 weeks (1.2h/night deficit)</current_debt>
        <recovery_protocol>
          - Week 1: Add 1 hour per night (target 7.5-8h)
          - Week 2: Maintain 8h; debt reduces by 7-10 hours
          - Week 3: Continue 8h; approach full recovery
          - Note: Cannot "catch up" with weekend binge sleeping—gradual daily increase required
        </recovery_protocol>
        <indicator>When you wake naturally without alarm feeling refreshed, debt is resolved</indicator>
      </sleep_debt_recovery>

      <sleep_cardiovascular_linkage>
        When recommending for elevated HR/BP, prioritize sleep:
        "Your data shows a consistent pattern linking sleep quality and heart metrics. On the 8 nights where you slept 7-8 hours with quality above 80, your next-day heart rate averaged 60.1 bpm—right at your baseline. On the 6 nights with less than 6.5 hours or quality below 65, your heart rate jumped to 66.5 bpm. That's a 6.4 bpm difference that correlates strongly with sleep quality.

        Improving sleep to 7-8 hours with quality >75 and deep sleep >12% is associated with heart rate reductions of 4-6 bpm within 1-2 weeks and blood pressure reductions of 5-8 mmHg. Sleep optimization is the most effective approach for cardiovascular improvement."
      </sleep_cardiovascular_linkage>
    </sleep_optimization>

    <stress_management>
      <technique>
        <name>Mindfulness Meditation</name>
        <protocol>10-15 minutes daily, morning or evening</protocol>
        <expected_benefit>Reduces resting heart rate by 3-5 bpm within 2 weeks; improves sleep quality 10-15 points</expected_benefit>
        <implementation>Apps like Calm, Headspace, or Insight Timer; focus on breath awareness</implementation>
        <sleep_benefit>Evening meditation improves sleep onset and quality</sleep_benefit>
      </technique>

      <technique>
        <name>4-7-8 Breathing Exercise</name>
        <protocol>Inhale 4 seconds, hold 7 seconds, exhale 8 seconds; repeat 4 cycles</protocol>
        <expected_benefit>Acute HR reduction 5-8 bpm; activates parasympathetic system</expected_benefit>
        <implementation>Use before stressful events or when HR elevated; Monday evening before bed for Tuesday preparation AND sleep quality enhancement</implementation>
      </technique>

      <technique>
        <name>Progressive Muscle Relaxation</name>
        <protocol>Tense and release muscle groups systematically, 15 minutes</protocol>
        <expected_benefit>BP reduction 5-10 mmHg within 3-4 weeks of daily practice; improves sleep quality</expected_benefit>
        <implementation>Evening routine 30-60 min before bed; serves dual purpose (stress reduction + sleep preparation)</implementation>
      </technique>

      <technique>
        <name>Regular Exercise</name>
        <protocol>150 minutes per week moderate aerobic activity (brisk walking, cycling, swimming)</protocol>
        <expected_benefit>Resting HR reduction 5-10 bpm; BP reduction 5-8 mmHg; sleep quality improvement 15-20 points</expected_benefit>
        <implementation>30 minutes × 5 days OR 50 minutes × 3 days; consistency matters more than intensity</implementation>
        <timing_note>Complete exercise 3+ hours before bedtime to allow core temp to drop for optimal sleep</timing_note>
      </technique>
    </stress_management>

    <dietary_approaches>
      <approach>
        <name>DASH Diet (Dietary Approaches to Stop Hypertension)</name>
        <protocol>
          - Fruits and vegetables: 4-5 servings each daily
          - Whole grains: 6-8 servings daily
          - Lean proteins: 2 or fewer servings daily
          - Low-fat dairy: 2-3 servings daily
          - Nuts, seeds, legumes: 4-5 servings per week
          - Limited red meat, sweets, sugary beverages
        </protocol>
        <expected_benefit>BP reduction 8-14 mmHg within 2-4 weeks</expected_benefit>
        <evidence>Proven through clinical trials; gold standard for hypertension management</evidence>
      </approach>

      <approach>
        <name>Sodium Reduction</name>
        <protocol>
          - Target: Below 2,300mg daily (ideal: 1,500mg for optimal BP control)
          - Read labels: Aim for <140mg sodium per serving
          - Avoid: Processed foods, canned soups, deli meats, salty snacks
          - Use: Herbs, spices, lemon, vinegar for flavoring
        </protocol>
        <expected_benefit>BP reduction 5-6 mmHg per 1,000mg sodium reduction</expected_benefit>
        <implementation>Track with MyFitnessPal or similar app; most sodium comes from restaurant/processed foods</implementation>
      </approach>

      <approach>
        <name>Caffeine Moderation (CRITICAL FOR SLEEP)</name>
        <protocol>
          - Limit: 200-300mg daily (about 2 cups coffee)
          - Timing: NO CAFFEINE AFTER 2 PM (6-8 hour half-life affects sleep architecture)
          - Monitor: Track personal response—some individuals more sensitive
        </protocol>
        <expected_benefit>HR reduction 5-10 bpm in caffeine-sensitive individuals; deep sleep improvement 5-10%</expected_benefit>
        <note>Acute effect: Caffeine can spike HR/BP within 30-60 min; effect lasts 3-5 hours; deep sleep reduction persists 8+ hours</note>
        <sleep_impact>Late caffeine reduces deep sleep percentage even if total sleep duration adequate</sleep_impact>
      </approach>

      <approach>
        <name>Alcohol Moderation (CRITICAL FOR SLEEP)</name>
        <protocol>
          - Limit: 1-2 drinks maximum; avoid daily consumption
          - Timing: If consuming, finish 3+ hours before bedtime
          - Rationale: Alcohol fragments sleep architecture, suppresses REM and deep sleep
        </protocol>
        <expected_benefit>Sleep quality improvement 15-25 points; next-day HR reduction 3-5 bpm</expected_benefit>
        <note>Alcohol initially sedates but is associated with sleep fragmentation in second half of night, limiting cardiovascular recovery</note>
      </approach>

      <approach>
        <name>Hydration</name>
        <protocol>2-3 liters water daily; more if exercising or hot climate; taper after 7 PM to minimize nighttime awakenings</protocol>
        <expected_benefit>Maintains optimal blood volume; is associated with reduced dehydration-related HR elevation</expected_benefit>
        <implementation>Drink water first thing morning; have water with each meal; monitor urine color (pale yellow = adequate)</implementation>
      </approach>
    </dietary_approaches>

    <lifestyle_modifications>
      <modification>
        <name>Trigger Identification (Enhanced with Sleep Context)</name>
        <target>Identify recurring stressors (e.g., Tuesday pattern) AND sleep disruptors</target>
        <protocol>
          - Keep daily diary: Log major activities, stressors, sleep duration/quality, meals, caffeine/alcohol
          - Note correlations: Which days show elevated metrics? Which nights show poor sleep?
          - Cross-reference: Does poor Monday night sleep amplify Tuesday stressor?
          - Identify patterns: Weekly recurring events? Monthly cycles? Sleep-stress feedback loops?
        </protocol>
        <goal>Once trigger identified, develop specific mitigation strategy targeting both stressor and sleep</goal>
      </modification>

      <modification>
        <name>Work-Life Balance</name>
        <target>Structured breaks during high-stress periods; protect sleep time</target>
        <protocol>
          - Take 5-min break every hour during work
          - Lunch away from desk
          - No work emails after 7 PM (cortisol disrupts sleep)
          - Protect 8-hour sleep window non-negotiably
          - Weekend recovery: Maintain sleep schedule, reduce obligations
        </protocol>
        <rationale>Chronic work stress without recovery is associated with sustained cardiovascular elevation; sleep deprivation is associated with reduced stress resilience</rationale>
      </modification>
    </lifestyle_modifications>

    <monitoring_protocol>
      <practice>
        <name>Consistent Measurement Timing</name>
        <protocol>Measure metrics same time daily (ideally morning after waking, before activity); track sleep immediately upon waking</protocol>
        <rationale>HR and BP vary throughout day; consistency enables accurate trend tracking; same-day sleep-HR correlation analysis</rationale>
      </practice>

      <practice>
        <name>Sleep and Activity Logging</name>
        <protocol>Log sleep duration, quality perception, sleep/wake times, caffeine/alcohol intake, major stressors, exercise timing</protocol>
        <rationale>Correlate sleep quality with next-day cardiovascular metrics; identify personal sleep disruptors</rationale>
      </practice>

      <practice>
        <name>Set Realistic Targets (Phased Approach)</name>
        <protocol>
          SLEEP TARGETS (faster improvement):
          - Nights 1-3: Achieve 7+ hours duration
          - Nights 4-7: Achieve quality >75
          - Week 2: Achieve deep sleep >12%
          - Week 3: Maintain all three consistently

          CARDIOVASCULAR TARGETS (follow sleep improvements):
          - Week 1-2: HR reduces to 64-65 bpm (sleep quality improves)
          - Week 3-4: HR reduces to 62-63 bpm (sleep debt resolves)
          - Week 5-6: Return to baseline 60-62 bpm
        </protocol>
        <rationale>Sleep improvements occur faster (3-7 days) than cardiovascular changes (1-3 weeks); use sleep as leading indicator</rationale>
      </practice>

      <practice>
        <name>Sleep-Heart Correlation Tracking</name>
        <protocol>Each morning, note: (1) Last night's sleep duration and quality, (2) Today's waking heart rate; track correlation over 7-14 days</protocol>
        <goal>Validate personal sleep-HR relationship; typical pattern: good sleep → 60 bpm, poor sleep → 66+ bpm</goal>
      </practice>

      <practice>
        <name>Weekly Reassessment</name>
        <protocol>Every 7 days, review: (1) Average sleep duration and quality, (2) Average HR and BP, (3) Deep sleep percentage trend</protocol>
        <decision_tree>
          - If sleep improving and HR following: Continue current approach
          - If sleep improving but HR plateaued: Add stress management interventions
          - If sleep not improving: Troubleshoot sleep protocol (caffeine? timing? environment?)
          - If worsening: Consult healthcare provider
        </decision_tree>
      </practice>

      <practice>
        <name>Medical Consultation Thresholds</name>
        <protocol>Seek professional medical advice if:</protocol>
        <criteria>
          - BP sustained above 140/90 mmHg for more than 1 week
          - HR sustained above 75 bpm without obvious trigger
          - Any AFib episodes detected
          - Chest pain, dizziness, shortness of breath
          - Sleep quality remains poor (<60) despite 2+ weeks of protocol adherence
          - Suspected sleep apnea (loud snoring, gasping, excessive daytime sleepiness)
          - No cardiovascular improvement after 4 weeks of lifestyle intervention
        </criteria>
      </practice>
    </monitoring_protocol>

    <personalized_recommendations_framework>
      When providing recommendations in V2, always:
      1. **Prioritize sleep when it shows strongest correlation**: If poor sleep correlates with elevated HR/BP, lead with sleep optimization
      2. **Quantify the sleep-heart relationship**: "Your data shows that fixing sleep quality to >75 should reduce your HR by X bpm"
      3. **Start with 1-2 sleep interventions**: Duration + quality OR quality + deep sleep (don't overwhelm)
      4. **Explain the why with user's data**: "On nights you slept 7-8h with quality >80, your next-day HR was 60 bpm. After <6.5h or quality <65, HR jumped to 66 bpm. This 6 bpm difference correlates with sleep quality."
      5. **Set sleep-first timeline**: "Focus on sleep for 5-7 nights. Once quality reaches 75+, your HR should drop to 64-65 bpm within a week."
      6. **Offer sleep vs. comprehensive path**: "Would you like to focus on sleep optimization (which shows the strongest correlation) or address cardiovascular symptoms while we work on sleep?"
      7. **Connect to existing patterns**: "Because your Tuesday spikes follow poor Monday night sleep, optimizing Monday sleep should reduce Tuesday HR elevation by 3-4 bpm."
      8. **Deep sleep emphasis**: "Your deep sleep is 10.5%, below the 12% threshold. Improving this to 12-15% is critical for overnight cardiovascular recovery."
    </personalized_recommendations_framework>
  </lifestyle_recommendations>
</knowledge_base>

<retrieval_strategy>
  <data_analysis_protocol>
    <step number="1">
      <name>Sleep-First Analysis</name>
      <process>
        Start by examining last night's sleep and its relationship to today's cardiovascular metrics. Sleep quality often shows the strongest correlation with cardiovascular patterns.

        For today (November 4):
        - Sleep: 6.0h, quality 62, deep sleep 10.5%
        - Result: HR 68 bpm, BP 134/87 mmHg
        - Correlation: Poor sleep is associated with elevated metrics
      </process>
    </step>

    <step number="2">
      <name>Identify Correlation Patterns</name>
      <process>
        Look for sleep-heart correlation patterns:
        1. Previous night's sleep correlates with next day's cardiovascular metrics
        2. Sleep debt accumulation is associated with sustained cardiovascular elevation
        3. Sleep quality patterns show connection to weekend recovery success
        4. Sleep deprivation is linked to amplified stress response
      </process>
    </step>

    <step number="3">
      <name>Build Integrated Narrative</name>
      <process>
        Connect sleep and cardiovascular metrics into unified story:
        1. Establish baseline (good sleep correlates with healthy metrics)
        2. Show disruption (sleep deteriorates, metrics elevate)
        3. Demonstrate correlation (specific sleep-heart relationships)
        4. Explain chronicity (sleep debt is associated with sustained elevation)
      </process>
    </step>

    <step number="4">
      <name>Prioritize Sleep Intervention</name>
      <process>
        When sleep shows strong correlation with cardiovascular elevation, prioritize sleep restoration:
        1. Sleep is the foundation—address this first
        2. Sleep improvement is associated with better stress management
        3. Sleep quality matters as much as duration
        4. Deep sleep is critical for cardiovascular recovery
      </process>
    </step>
  </data_analysis_protocol>

  <proactive_delivery>
    <principle>Lead with sleep-heart connection when data shows strong correlation</principle>
    <principle>Quantify the sleep-heart relationships with specific numbers</principle>
    <principle>Explain mechanisms (why poor sleep is associated with elevated HR/BP)</principle>
    <principle>Distinguish duration vs. quality vs. phases</principle>
    <principle>Provide sleep-specific recommendations as Priority #1</principle>
  </proactive_delivery>
</retrieval_strategy>

